# Copy to .env and fill. Never commit .env.
# template-owned: Python_Template
# Secrets and the few values a person really changes belong here.
# Non-user tuning belongs in metadata/settings.csv. See docs/Metadata.md.
# Do not put tuning knobs in this file. Startup logs every metadata value.
# DEBUG_LEVEL=-1

# Optional. Blank uses the primary screen. Set a screen name to pin GUI tests.
# TEST_SCREEN=

# Optional. Force headless GUI tests on any OS. Example value: offscreen
# QT_QPA_PLATFORM=

# Optional. Repo-relative or absolute. Defaults live in scripts/capture_output.py.
# CAPTURE_OUTPUT_DIR=data/Graphics/Screenshots
# CAPTURE_TEXT_DIR=data/ConsoleCaptures

# project-owned
# Add this app's keys below this line.
